# ── Stage files ─────────────────────────────────────────────────────────────
# Three stages, each with its own env file (all gitignored except this one):
#   local  -> .env.test        (Docker Postgres + rustfs,  nub run dev:local)
#   dev    -> .env             (Neon dev + R2 dev,         nub run dev)
#   prod   -> .env.production  (Neon prod + R2 prod,       nub run dev:prod)
#
# The DB CLI is stage-aware: STAGE=local|dev|prod nub run db <command>
#   e.g. STAGE=prod nub run db migrate   (or: nub run db:prod migrate)
# ─────────────────────────────────────────────────────────────────────────────
#
# Local Cloudflare preview (`nub run server`) generates `.dev.vars` from this
# stage's `.env` automatically; see scripts/prepare-dev-vars.mjs.

# NOTE: do NOT put NODE_ENV or APP_ENV in this file. Scripts set them
# themselves (e.g. `nub run dev` → APP_ENV=development NODE_ENV=development,
# `nub run build:dev` → APP_ENV=development NODE_ENV=production). APP_ENV tells
# nub which stage's env file to load (.env / .env.test / .env.production) while
# NODE_ENV controls the React runtime — decoupled. If `.env` contained
# NODE_ENV=development, a deploy build could end up on React's dev JSX runtime
# and 500 on Cloudflare.

## Docker Postgre container
# POSTGRES_HOST=localhost
# POSTGRES_DB=sakuga
# POSTGRES_USER=user
# POSTGRES_PASSWORD=password
# DATABASE_URL="postgresql://user:password@localhost:5432/sakuga"

VITE_BASE_URL=http://localhost:3000

DATABASE_URL="postgresql://neondburl"

# Use the Docker Postgres pool instead of the Neon driver (dev:local).
# DATABASE_DRIVER=local

# pnpm dlx @better-auth/cli@latest secret
BETTER_AUTH_SECRET=
BETTER_AUTH_ORIGIN=http://localhost:3000

# OAuth2 providers, optional, update as needed
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public Google OAuth client ID, baked into the client bundle. The Google
# login button only renders when this is set (requires GOOGLE_CLIENT_ID /
# GOOGLE_CLIENT_SECRET server-side + callback registration).
VITE_GOOGLE_CLIENT_ID=

# NOTE:
# In your OAuth2 apps, set callback/redirect URIs to`http://localhost:3000/api/auth/callback/<provider>`
# e.g. http://localhost:3000/api/auth/callback/github

CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ACCESS_EMAIL=
CLOUDFLARE_BUCKET=
# R2 S3 endpoint. EU-jurisdiction buckets require the `.eu` host, e.g.
# https://<account-id>.eu.r2.cloudflarestorage.com
CLOUDFLARE_R2=
CLOUDFLARE_ACCESS_KEY=
CLOUDFLARE_SECRET_KEY=
# Public URL of the R2 custom domain that serves the bucket.
VITE_CLOUDFLARE_R2_PUBLIC_URL=

# Invisible Cloudflare Turnstile (production only, sign-in/sign-up protection).
# Provisioned via infra/alchemy.run.ts (Cloudflare.Turnstile.Widget); the
# sitekey is public, the secret is verified server-side by the captcha plugin.
VITE_TURNSTILE_SITEKEY=
TURNSTILE_SECRET=
# CLOUDFLARE_TOKEN=
