# ViteSakuga environment schema
#
# Nub loads this file through Varlock before running a file or package script.
# Values in .env, .env.test, and .env.production override the defaults below.
# Keep this file free of real credentials.

# @currentEnv=$APP_ENV
# @defaultRequired=false
# @defaultSensitive=false

# The stage is selected by the package scripts and controls Varlock's
# environment-specific file resolution.
# @type=enum(development, test, production)
APP_ENV=development

# @auditIgnore
# @type=enum(development, production, test)
NODE_ENV=development

# @auditIgnore
MODE=development

# @auditIgnore
DEV=false

# @auditIgnore
CI=false

# @auditIgnore
CDP_HTTP=

# @auditIgnore
CDP_WS_ENDPOINT=

# @auditIgnore
E2E_CONFIG=

# @auditIgnore
# @required @type=string(minLength=1) @sensitive
BETTER_AUTH_SECRET=

# Resend is optional for local/test boot, but required before enabling
# production email verification.
# @type=string(allowEmpty=true) @sensitive
RESEND_API_KEY=

# @type=string(allowEmpty=true)
EMAIL_FROM=

# @auditIgnore
# @required @type=string(minLength=1)
VITE_BASE_URL=http://localhost:3000

# @required @type=string(minLength=1)
DATABASE_URL=

# @required @type=string(minLength=1)
CLOUDFLARE_BUCKET=

# @required @type=string(minLength=1)
CLOUDFLARE_R2=

# @required @type=string(minLength=1) @sensitive
CLOUDFLARE_ACCESS_KEY=

# @required @type=string(minLength=1) @sensitive
CLOUDFLARE_SECRET_KEY=

# @required @type=string(minLength=1)
VITE_CLOUDFLARE_R2_PUBLIC_URL=

# OAuth credentials are required only for production. They may be empty in
# development and test, matching src/lib/env/defs.ts.
# @required=forEnv(production) @type=string(minLength=1)
GITHUB_CLIENT_ID=

# @required=forEnv(production) @type=string(minLength=1) @sensitive
GITHUB_CLIENT_SECRET=

# @required=forEnv(production) @type=string(minLength=1)
GOOGLE_CLIENT_ID=

# @required=forEnv(production) @type=string(minLength=1) @sensitive
GOOGLE_CLIENT_SECRET=

# Optional captcha configuration. The local scripts override the public
# settings explicitly; production infra supplies the secret binding.
# @type=string(allowEmpty=true)
VITE_TURNSTILE_SITEKEY=

# @type=string(allowEmpty=true)
VITE_TURNSTILE_REQUIRED=

# @type=string(allowEmpty=true) @sensitive
TURNSTILE_SECRET=

# Used by the infrastructure and database CLIs.
# @type=string(allowEmpty=true)
DATABASE_DRIVER=

# @type=string(allowEmpty=true)
OTEL_EXPORTER_OTLP_ENDPOINT=

# @type=boolean
SEED_DB=false

# @type=enum(development, dev, production, prod, local, test)
STAGE=development

# Infrastructure/deployment inputs. These are consumed by Alchemy, Wrangler,
# or local tooling rather than by the application environment schema.
# @type=string(allowEmpty=true)
CLOUDFLARE_ACCOUNT_ID=

# @type=string(allowEmpty=true)
CLOUDFLARE_ACCESS_EMAIL=

# @type=string(allowEmpty=true) @sensitive
CLOUDFLARE_API_TOKEN=

# @type=string(allowEmpty=true)
BETTER_AUTH_ORIGIN=http://localhost:3000

# @type=string(allowEmpty=true)
VITE_GOOGLE_CLIENT_ID=
