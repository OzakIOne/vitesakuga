{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "signoz": {
      "type": "remote",
      "url": "http://localhost:8000/mcp",
      "enabled": false
    },
    "ark-ui": {
      "type": "local",
      "command": ["bunx", "-y", "@ark-ui/mcp"]
    },
    "knip": {
      "type": "local",
      "command": ["bunx", "-y", "@knip/mcp"]
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      }
    },
    "tanstack": {
      "type": "remote",
      "url": "https://tanstack.com/api/mcp"
    },
      "browser-control": {
        "type": "local",
        "command": ["browser-control-mcp"]
      }

  },
  "references": {
    "effect": {
      "repository": "github.com/Effect-TS/effect-smol",
      "description": "use this whenever there's a question about effect or you need to know how to do something in effect"
    },
    "effect-accountability": {
      "repository": "github.com/mikearnaldi/accountability",
      "description": "use this to see how effect is used in a real project"
    },
    "docs": {
      "path": "./docs"
    }
  },
  "plugin": [".opencode/plugins/graphify.js"],
  "lsp": true
}
