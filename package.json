{
  "name": "vitesakuga",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "build": "vite build",
    "db": "drizzle-kit",
    "db:local": "STAGE=local drizzle-kit",
    "db:prod": "STAGE=prod drizzle-kit",
    "dcd": "docker compose down",
    "dcu": "docker compose up -d",
    "dev": "VITE_BASE_URL=http://localhost:3000 NODE_ENV=development vite dev --mode development --host",
    "dev:local": "NODE_ENV=test DATABASE_DRIVER=local vite dev --mode test --host",
    "dev:prod": "NODE_ENV=production vite dev --mode production",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "infra:deploy": "alchemy deploy infra/alchemy.run.ts --stage dev",
    "infra:deploy:prod": "alchemy deploy infra/alchemy.run.ts --stage production --env-file .env.production",
    "infra:dev": "alchemy dev infra/alchemy.run.ts --stage dev",
    "infra:destroy": "alchemy destroy infra/alchemy.run.ts --stage dev",
    "infra:destroy:prod": "alchemy destroy infra/alchemy.run.ts --stage production --env-file .env.production",
    "knip": "knip",
    "lint": "oxlint . --fix",
    "lint:check": "oxlint . --type-check --type-aware",
    "oc": "opencode web --hostname 0.0.0.0 --mdns",
    "neonctl": "neonctl",
    "prepare": "effect-tsgo patch --typescript --oxlint",
    "server": "vite preview",
    "start": "node .output/server/index.mjs",
    "test": "vitest -w",
    "test:e2e": "playwright test --config=e2e/playwright.config.ts",
    "test:e2e:lightpanda": "CDP_HTTP=http://127.0.0.1:9223 E2E_CONFIG=e2e/playwright.lightpanda.config.ts node e2e/setup-cdp.mjs",
    "test:e2e:ui": "playwright test --config=e2e/playwright.config.ts --ui",
    "wrangler:dev": "wrangler pages dev --proxy 3000 -- pnpm vite dev --mode development",
    "wrangler:preview": "wrangler pages dev .output/public",
    "look": "bun scripts/lookup-opencode-session.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1108.0",
    "@chakra-ui/react": "^3.36.1",
    "@effect/opentelemetry": "4.0.0-beta.102",
    "@effect/platform-node": "4.0.0-beta.107",
    "@emotion/react": "^11.14.0",
    "@neondatabase/serverless": "^1.1.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-logs-otlp-http": "^0.221.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-logs": "^0.221.0",
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "@opentelemetry/sdk-trace-node": "^2.10.0",
    "@opentelemetry/sdk-trace-web": "^2.10.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/db": "^0.6.17",
    "@tanstack/query-db-collection": "^1.2.1",
    "@tanstack/react-db": "^0.1.95",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-form-devtools": "^0.2.34",
    "@tanstack/react-hotkeys": "^0.10.0",
    "@tanstack/react-pacer": "^0.23.0",
    "@tanstack/react-pacer-devtools": "0.8.0",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-query-devtools": "^5.101.4",
    "@tanstack/react-router": "^1.170.25",
    "@tanstack/react-router-devtools": "^1.167.1",
    "@tanstack/react-router-ssr-query": "^1.167.1",
    "@tanstack/react-start": "^1.168.42",
    "@xstate/react": "^7.0.0-alpha.1",
    "alchemy": "2.0.0-beta.72",
    "better-auth": "1.7.0-rc.4",
    "drizzle-kit": "1.0.0-rc.4",
    "drizzle-orm": "1.0.0-rc.4",
    "effect": "^4.0.0-rc.108",
    "isomorphic-dompurify": "^3.22.0",
    "kysely": "^0.29.5",
    "media-chrome": "^4.19.2",
    "mediabunny": "^1.53.0",
    "mediainfo.js": "^0.3.7",
    "neonctl": "^2.47.0",
    "next-themes": "^0.4.6",
    "pg": "^8.23.0",
    "postgres": "^3.4.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "xstate": "^6.0.0-alpha.36"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.51.3",
    "@cloudflare/workers-types": "^5.20260811.1",
    "@effect/eslint-plugin": "^0.3.2",
    "@effect/language-service": "^0.87.2",
    "@effect/tsgo": "0.36.4",
    "@electric-sql/pglite": "^0.5.4",
    "@playwright/test": "^1.62.1",
    "@tanstack/devtools-vite": "^0.8.3",
    "@tanstack/eslint-plugin-query": "^5.101.4",
    "@tanstack/eslint-plugin-router": "^1.162.0",
    "@tanstack/react-devtools": "^0.10.10",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.21.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "dotenv": "^17.4.2",
    "drizzle-seed": "1.0.0-rc.4",
    "happy-dom": "^20.11.2",
    "knip": "^6.32.2",
    "nitro": "3.0.260610-beta",
    "oxfmt": "0.62.0",
    "oxlint": "1.77.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "wrangler": "^4.121.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "onFail": "download"
    }
  },
  "engines": {
    "node": "26"
  }
}
