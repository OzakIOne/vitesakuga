{
  "name": "vitesakuga",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "sideEffects": false,
  "scripts": {
    "dev": "APP_ENV=development NODE_ENV=development VITE_TURNSTILE_SITEKEY=2x00000000000000000000AB TURNSTILE_SECRET=1x0000000000000000000000000000000AA VITE_TURNSTILE_REQUIRED=0 varlock run -- vite dev --mode development --host",
    "dev:local": "APP_ENV=test NODE_ENV=test DATABASE_DRIVER=local VITE_TURNSTILE_SITEKEY=2x00000000000000000000AB TURNSTILE_SECRET=1x0000000000000000000000000000000AA VITE_TURNSTILE_REQUIRED=0 varlock run -- vite dev --mode test --host --port 3200",
    "dev:prod": "APP_ENV=production NODE_ENV=production varlock run -- vite dev --mode production --port 3300",
    "build": "APP_ENV=production NODE_ENV=production varlock run -- vite build --mode production",
    "build:dev": "APP_ENV=development NODE_ENV=production varlock run -- vite build --mode development",
    "start": "varlock run -- node .output/server/index.mjs",
    "server": "varlock run -- vite preview",
    "wrangler:dev": "wrangler pages dev --proxy 3000 -- pnpm exec varlock run -- vite dev --mode development",
    "wrangler:preview": "wrangler pages dev .output/public",
    "db": "drizzle-kit",
    "db:dev": "STAGE=dev NODE_ENV=development drizzle-kit",
    "db:local": "STAGE=local NODE_ENV=test drizzle-kit",
    "db:prod": "STAGE=prod NODE_ENV=production drizzle-kit",
    "neonctl": "neonctl",
    "infra:dev": "varlock run -- alchemy dev infra/alchemy.run.ts --stage dev",
    "infra:deploy": "pnpm run build:dev && node scripts/check-prod-build.mjs && varlock run -- alchemy deploy infra/alchemy.run.ts --stage dev",
    "infra:deploy:prod": "pnpm run build && node scripts/check-prod-build.mjs && alchemy deploy infra/alchemy.run.ts --stage production --env-file .env.production",
    "github:preproduction": "varlock run -- alchemy deploy infra/github-environment.run.ts --stage preproduction --adopt --yes",
    "github:production": "alchemy deploy infra/github-environment.run.ts --stage production --env-file .env.production --adopt --yes",
    "infra:preproduction": "pnpm run github:preproduction && pnpm run infra:deploy --yes",
    "infra:destroy": "varlock run -- alchemy destroy infra/alchemy.run.ts --stage dev",
    "infra:destroy:prod": "alchemy destroy infra/alchemy.run.ts --stage production --env-file .env.production",
    "dcu": "docker compose up -d",
    "dcd": "docker compose down",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint . --fix --ignore-pattern '.commandcode/**'",
    "lint:check": "effect-tsgo --tsrs-lint=0.25.0-ts7.1.0-beta oxlint . --type-check --type-aware --ignore-pattern '.commandcode/**'",
    "knip": "knip",
    "knip:production": "knip --production --include files,dependencies",
    "typecheck": "tsc --noEmit && pnpm run typecheck:fast",
    "typecheck:fast": "effect-tsgo tsrs@0.25.0-ts7.1.0-beta --noEmit",
    "test": "vitest -w",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:deployment": "vitest run scripts/cloudflare-release.test.mjs",
    "test:ee": "varlock run -- playwright test --config=e2e/playwright.config.ts",
    "test:ee:lightpanda": "CDP_HTTP=http://127.0.0.1:9223 E2E_CONFIG=e2e/playwright.lightpanda.config.ts varlock run -- node e2e/setup-cdp.mjs",
    "test:ee:ui": "varlock run -- playwright test --config=e2e/playwright.config.ts --ui",
    "oc": "opencode web --hostname 0.0.0.0 --mdns",
    "look": "bun scripts/lookup-opencode-session.ts",
    "prepare": "effect-tsgo patch --typescript --oxlint"
  },
  "dependencies": {
    "@ark-ui/react": "^5.40.0",
    "@aws-sdk/client-s3": "^3.1169.0",
    "@aws-sdk/s3-request-presigner": "^3.1169.0",
    "@better-auth/passkey": "^1.7.23",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@effect/opentelemetry": "4.1.4",
    "@neondatabase/serverless": "^1.2.1",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/api-logs": "0.223.0",
    "@opentelemetry/exporter-logs-otlp-http": "0.223.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.0",
    "@opentelemetry/resources": "2.12.0",
    "@opentelemetry/sdk-logs": "0.223.0",
    "@opentelemetry/sdk-metrics": "2.12.0",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "@opentelemetry/sdk-trace-node": "2.12.0",
    "@opentelemetry/sdk-trace-web": "2.12.0",
    "@opentelemetry/semantic-conventions": "1.45.0",
    "@tanstack/markdown": "^1.2.0",
    "@tanstack/query-db-collection": "^1.5.2",
    "@tanstack/react-db": "^1.0.0-rc.1.5",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-hotkeys": "^0.25.0",
    "@tanstack/react-pacer": "^0.24.1",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.169.5",
    "@tanstack/react-table": "^9.3.1",
    "@tanstack/react-virtual": "^3.14.26",
    "@xstate/react": "^7.0.0-beta.0",
    "better-auth": "1.7.23",
    "check-password-strength": "3.0.0",
    "cn": "^0.5.2",
    "drizzle-orm": "1.0.0-rc.5",
    "effect": "4.1.4",
    "kysely": "^0.29.9",
    "media-chrome": "^4.19.5",
    "mediabunny": "1.66.0",
    "mediainfo.js": "^0.3.8",
    "next-themes": "^0.4.6",
    "pg": "^8.23.1",
    "postgres": "^4.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0",
    "react-qr-code": "^2.2.0",
    "sanitize-html": "^2.18.2",
    "xstate": "^6.0.0-beta.2",
    "yet-another-react-lightbox": "^3.33.0"
  },
  "devDependencies": {
    "@alchemy.run/cloudflare": "2.0.0-beta.87",
    "@alchemy.run/github": "2.0.0-beta.87",
    "@alchemy.run/neon": "2.0.0-beta.87",
    "@cloudflare/workers-types": "^5.20261114.1",
    "@effect/eslint-plugin": "^0.3.2",
    "@effect/language-service": "^0.87.5",
    "@effect/tsgo": "0.69.0",
    "@electric-sql/pglite": "^0.5.16",
    "@opencode-ai/browser-control": "^0.8.4",
    "@oxlint/plugins": "1.93.0",
    "@playwright/test": "^1.65.1",
    "@shadcn/lint": "^0.2.5",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/devtools-vite": "^0.8.6",
    "@tanstack/eslint-plugin-query": "^5.107.1",
    "@tanstack/eslint-plugin-router": "^1.162.0",
    "@tanstack/react-devtools": "^0.10.14",
    "@tanstack/react-form-devtools": "^0.2.34",
    "@tanstack/react-pacer-devtools": "0.9.1",
    "@tanstack/react-query-devtools": "^5.107.1",
    "@tanstack/react-router-devtools": "^1.167.3",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/browser": "5.1.0",
    "@vitest/browser-playwright": "5.1.0",
    "@vitest/ui": "5.1.0",
    "alchemy": "2.0.0-beta.87",
    "dotenv": "^18.0.10",
    "drizzle-kit": "1.0.0-rc.5",
    "drizzle-seed": "1.0.0-rc.5",
    "knip": "^6.45.1",
    "miniflare": "4.20260730.0",
    "neonctl": "^9.5.0",
    "nitro": "3.0.261103-rc",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2007",
    "playwright": "1.65.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "varlock": "^1.25.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "vitest-browser-react": "2.3.0",
    "wrangler": "^4.162.0",
    "ws": "8.23.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "onFail": "download"
    }
  },
  "engines": {
    "node": "26"
  }
}
