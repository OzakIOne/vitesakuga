{
  "name": "vitesakuga",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "dev": "APP_ENV=development NODE_ENV=development VITE_TURNSTILE_SITEKEY=2x00000000000000000000AB TURNSTILE_SECRET=1x0000000000000000000000000000000AA VITE_TURNSTILE_REQUIRED=0 vite dev --mode development --host",
    "dev:local": "APP_ENV=test NODE_ENV=test DATABASE_DRIVER=local VITE_TURNSTILE_SITEKEY=2x00000000000000000000AB TURNSTILE_SECRET=1x0000000000000000000000000000000AA VITE_TURNSTILE_REQUIRED=0 vite dev --mode test --host --port 3200",
    "dev:prod": "APP_ENV=production NODE_ENV=production vite dev --mode production --port 3300",
    "build": "APP_ENV=production NODE_ENV=production vite build --mode production",
    "build:dev": "APP_ENV=development NODE_ENV=production vite build --mode development",
    "start": "nub .output/server/index.mjs",
    "server": "vite preview",
    "wrangler:dev": "wrangler pages dev --proxy 3000 -- nub run vite dev --mode development",
    "wrangler:preview": "wrangler pages dev .output/public",
    "db": "drizzle-kit",
    "db:dev": "STAGE=dev NODE_ENV=development drizzle-kit",
    "db:local": "STAGE=local NODE_ENV=test drizzle-kit",
    "db:prod": "STAGE=prod NODE_ENV=production drizzle-kit",
    "neonctl": "neonctl",
    "infra:dev": "alchemy dev infra/alchemy.run.ts --stage dev",
    "infra:deploy": "nub run build:dev && nub scripts/check-prod-build.mjs && alchemy deploy infra/alchemy.run.ts --stage dev",
    "infra:deploy:prod": "nub run build && nub scripts/check-prod-build.mjs && alchemy deploy infra/alchemy.run.ts --stage production --env-file .env.production",
    "github:preproduction": "alchemy deploy infra/github-environment.run.ts --stage preproduction --adopt --yes",
    "github:production": "alchemy deploy infra/github-environment.run.ts --stage production --env-file .env.production --adopt --yes",
    "infra:preproduction": "nub run github:preproduction && nub run infra:deploy --yes",
    "infra:destroy": "alchemy destroy infra/alchemy.run.ts --stage dev",
    "infra:destroy:prod": "alchemy destroy infra/alchemy.run.ts --stage production --env-file .env.production",
    "dcu": "docker compose up -d",
    "dcd": "docker compose down",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint . --fix",
    "lint:check": "oxlint . --type-check --type-aware",
    "knip": "knip",
    "knip:production": "knip --production --include files,dependencies",
    "test": "vitest -w",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:deployment": "nub exec vitest run scripts/cloudflare-release.test.mjs",
    "test:ee": "playwright test --config=e2e/playwright.config.ts",
    "test:ee:lightpanda": "CDP_HTTP=http://127.0.0.1:9223 E2E_CONFIG=e2e/playwright.lightpanda.config.ts nub e2e/setup-cdp.mjs",
    "test:ee:ui": "playwright test --config=e2e/playwright.config.ts --ui",
    "oc": "opencode web --hostname 0.0.0.0 --mdns",
    "look": "bun scripts/lookup-opencode-session.ts",
    "prepare": "effect-tsgo patch --typescript --oxlint"
  },
  "dependencies": {
    "@ark-ui/react": "^5.39.3",
    "@aws-sdk/client-s3": "^3.1151.0",
    "@aws-sdk/s3-request-presigner": "^3.1151.0",
    "@better-auth/passkey": "^1.7.7",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@effect/opentelemetry": "4.0.4",
    "@neondatabase/serverless": "^1.2.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "0.223.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.223.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-logs": "^0.223.0",
    "@opentelemetry/sdk-metrics": "2.12.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@opentelemetry/sdk-trace-node": "^2.12.0",
    "@opentelemetry/sdk-trace-web": "^2.12.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@tanstack/markdown": "^1.0.0",
    "@tanstack/query-db-collection": "^1.4.3",
    "@tanstack/react-db": "^0.5.8",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-hotkeys": "^0.13.0",
    "@tanstack/react-pacer": "^0.24.1",
    "@tanstack/react-query": "^5.104.2",
    "@tanstack/react-router": "^1.170.44",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.169.1",
    "@tanstack/react-table": "^9.3.1",
    "@tanstack/react-virtual": "^3.14.19",
    "@xstate/react": "^7.0.0-alpha.4",
    "better-auth": "1.7.7",
    "check-password-strength": "3.0.0",
    "cn": "^0.4.0",
    "drizzle-orm": "1.0.0-rc.4",
    "effect": "4.0.4",
    "kysely": "^0.29.6",
    "media-chrome": "^4.19.3",
    "mediabunny": "1.61.4",
    "mediainfo.js": "^0.3.8",
    "next-themes": "^0.4.6",
    "pg": "^8.23.1",
    "postgres": "^3.4.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-icons": "^5.7.0",
    "react-qr-code": "^2.2.0",
    "sanitize-html": "^2.18.0",
    "xstate": "^6.0.0-alpha.65",
    "yet-another-react-lightbox": "^3.32.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261013.1",
    "@effect/eslint-plugin": "^0.3.2",
    "@effect/language-service": "^0.87.4",
    "@effect/tsgo": "0.52.0",
    "@electric-sql/pglite": "^0.5.9",
    "@opencode-ai/browser-control": "^0.8.4",
    "@oxlint/plugins": "1.87.0",
    "@playwright/test": "^1.64.0",
    "@shadcn/lint": "^0.2.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/devtools-vite": "^0.8.5",
    "@tanstack/eslint-plugin-query": "^5.104.2",
    "@tanstack/eslint-plugin-router": "^1.162.0",
    "@tanstack/react-devtools": "^0.10.13",
    "@tanstack/react-form-devtools": "^0.2.34",
    "@tanstack/react-pacer-devtools": "0.9.1",
    "@tanstack/react-query-devtools": "^5.104.2",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@types/bun": "^1.4.3",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser": "5.0.4",
    "@vitest/browser-playwright": "5.0.4",
    "alchemy": "2.0.0-beta.83",
    "dotenv": "^18.0.7",
    "drizzle-kit": "1.0.0-rc.4",
    "drizzle-seed": "1.0.0-rc.4",
    "knip": "^6.41.0",
    "miniflare": "4.20260730.0",
    "neonctl": "^8.4.3",
    "nitro": "3.0.260610-beta",
    "oxfmt": "0.73.0",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2004",
    "playwright": "1.64.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "varlock": "^1.22.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "vitest-browser-react": "2.3.0",
    "wrangler": "^4.150.0",
    "ws": "8.22.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "onFail": "download"
    }
  },
  "engines": {
    "node": "26"
  }
}
